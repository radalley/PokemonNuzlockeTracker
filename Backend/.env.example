# Copy this to .env and fill in your values
DATABASE_URL=postgresql://username:password@localhost:5432/lockley

# Flask secret key - change this to a random string in production
LOCKLEY_SECRET_KEY=lockley-dev-secret-change-me

# Set to 1 in production (HTTPS only)
LOCKLEY_SECURE_COOKIES=0

# Comma-separated frontend origins allowed by CORS. Leave unset for
# allow-all (local dev); set on Render to lock the API to your frontends,
# e.g. CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5174
CORS_ORIGINS=

# Set to 1 to enable the Werkzeug debugger when running api.py directly
FLASK_DEBUG=0
